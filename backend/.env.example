# ---------------------------------------------------------------
# CancerBioMap backend configuration (copy to backend/.env)
# ---------------------------------------------------------------
# PostgreSQL (recommended / production schema target)
#   DATABASE_URL=postgresql+psycopg://cancerbiomap:<password>@localhost:5432/cancerbiomap
# SQLite development fallback (used when DATABASE_URL is not set)
DATABASE_URL=sqlite:///./cancerbiomap.db

# Comma-separated list of origins allowed to call the API (Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Evidence-support score weights (P, D, T, C). Must sum to 1.0.
# These are proposed project parameters, NOT validated clinical standards.
SCORE_WEIGHT_PUBLICATION=0.35
SCORE_WEIGHT_SOURCE_DIVERSITY=0.25
SCORE_WEIGHT_EVIDENCE_TYPE=0.25
SCORE_WEIGHT_CONSISTENCY=0.15

# Publication count at which the publication-support component saturates at 100
SCORE_PUBLICATION_CAP=5
# Minimum fraction of total weight that must be observed to report a provisional score
SCORE_MIN_COVERAGE=0.5
# Corroboration discount (lambda) for additional, weaker study designs in the evidence-type component (0-1)
SCORE_BREADTH_DISCOUNT=0.25

# Optional: shared secret required (X-Admin-Token header) for write endpoints. Leave empty for a local demo.
ADMIN_TOKEN=

# Optional: contact e-mail and API key for NCBI E-utilities (scripts/fetch_pubmed.py)
NCBI_EMAIL=
NCBI_API_KEY=
